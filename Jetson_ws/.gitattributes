# Keep Linux-run files as LF even when edited/checked out on Windows, so Jetson
# shell scripts, systemd units, and shebang Python keep working. Windows batch
# stays CRLF.
*.sh        text eol=lf
*.service   text eol=lf
*.env       text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.bat       text eol=crlf

# Binary assets git must not touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.bmp   binary
*.engine binary
*.onnx  binary
*.pt    binary
*.tar.gz binary
*.whl   binary
