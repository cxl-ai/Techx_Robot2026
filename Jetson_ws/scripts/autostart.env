# Boot auto-start toggle for techx-vision.service (read by systemd EnvironmentFile
# and by scripts/run_vision_service.sh). Edit this one line, no systemctl needed:
#
#   TECHX_AUTOSTART=false  -> Orin boots normally, vision does NOT auto-run (manual).
#   TECHX_AUTOSTART=true   -> Orin runs the vision automatically on every boot.
#
# After changing it: sudo systemctl restart techx-vision (or just reboot).
TECHX_AUTOSTART=false

# Optional overrides for the boot run (only used when TECHX_AUTOSTART=true):
TECHX_STAGE=head
TECHX_DEBUG_RECORDER=1
LOG_LEVEL=INFO
# Model switch: point the weapon-head model at any weights file (no config edit /
# no copy). Leave empty to use models/head_v1/best.pt. Example:
#   TECHX_HEAD_WEIGHTS=/home/techx/models/weapon_seg_v5.pt
TECHX_HEAD_WEIGHTS=
